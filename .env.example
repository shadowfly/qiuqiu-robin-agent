# Copy to .env and fill in. Never commit the filled-in file: these are live
# credentials, and a key that reaches a commit, a log or a report is burned.
# The scripts read the environment directly, so export these or run them with
# a loader such as `env $(grep -v '^#' .env | xargs) node skill/scripts/...`.

# ---------------------------------------------------------------------------
# Required only for the features that use them
# ---------------------------------------------------------------------------

# Moni Discover, used for social traction and smart-follower evidence.
# Without it the Moni probes report unavailable; the on-chain probe is
# unaffected and still runs on its own.
MONI_API_KEY=

# OpenAI-compatible gateway used for sourced web research. Without the key the
# search adapter reports unavailable and the skill falls back to the agent's
# own web search. The key is read from the environment only: never pass it as
# a command argument, where it lands in shell history and process listings.
GROK_API_KEY=

# ---------------------------------------------------------------------------
# Optional. Every one of these has a working default; set them only to change it.
# ---------------------------------------------------------------------------

# Chat-completions endpoint. Default: https://ai.taosu.xyz/v1/chat/completions
GROK_API_URL=

# Model id. Case-sensitive at the gateway: `grok-chat-fast`, not `Grok-chat-fast`.
# Default: grok-chat-fast
GROK_SEARCH_MODEL=

# Per-attempt timeout in ms. A synthesized, sourced answer normally takes
# 30-60s, so a low ceiling fails every real query while a trivial ping passes.
# Default: 90000
GROK_SEARCH_TIMEOUT_MS=

# Search response cache. Set to 0 to disable. Default: on, 600000 ms TTL,
# stored under the system temp directory.
GROK_SEARCH_CACHE=
GROK_SEARCH_CACHE_TTL_MS=

# Moni response cache. Set MONI_CACHE=0 to disable. Default: on, 900000 ms TTL.
# MONI_CACHE_DIR defaults to a directory under the system temp directory.
MONI_CACHE=
MONI_CACHE_TTL_MS=
MONI_CACHE_DIR=
